{
  "manifest_version": 3,
  "name": "ApplyIQ – Save Jobs",
  "version": "1.1.0",
  "description": "Save job listings to ApplyIQ with one click.",
  "permissions": ["activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://npighgicwmefjzewzmit.supabase.co/*",
    "https://*.linkedin.com/*",
    "https://*.joinhandshake.com/*",
    "https://app.joinhandshake.com/*",
    "https://joinhandshake.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content_linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.joinhandshake.com/*",
        "https://*.joinhandshake.com/*",
        "https://joinhandshake.com/*"
      ],
      "js": ["content_handshake_test.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.joinhandshake.com/*",
        "https://*.joinhandshake.com/*",
        "https://joinhandshake.com/*"
      ],
      "js": ["content_handshake.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to ApplyIQ"
  }
}
